                document.getElementById('ai-typing')?.remove();

                if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
                    playRecvSound();
                    appendChatMessage('ai', data.candidates[0].content.parts[0].text);
                } else {
                    throw new Error("Parse error");
                }
            } catch (err) {
                document.getElementById('ai-typing')?.remove();
                playRecvSound();
                appendChatMessage('ai', "I am 'kali' by TokemekiAI company (CEO Etlijah Atienza / xlex175). Ready for Lua and security analysis.");
            }
        }

        function appendChatMessage(sender, text) {
            const isUser = sender === 'user';
            const div = document.createElement('div');
            div.className = `flex items-start space-x-2.5 ${isUser ? 'justify-end' : ''}`;

            if (!isUser) {
                div.innerHTML = `
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-kaliCard border border-kaliCyan/60 flex items-center justify-center p-1 shrink-0">
                        <img src="https://www.kali.org/images/kali-dragon-icon.svg" alt="Logo" class="w-full h-full object-contain">
                    </div>
                    <div class="bg-kaliCard border border-kaliBorder p-3 rounded-xl text-gray-200 text-xs sm:text-sm max-w-[85%] sm:max-w-2xl leading-relaxed font-mono whitespace-pre-wrap">${escapeHtml(text)}</div>
                `;
            } else {
                div.innerHTML = `
                    <div class="bg-gradient-to-r from-kaliCard to-[#101e38] border border-gray-700 p-3 rounded-xl text-gray-100 text-xs sm:text-sm max-w-[85%] sm:max-w-2xl leading-relaxed font-mono whitespace-pre-wrap">${escapeHtml(text)}</div>
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-kaliBlue/20 border border-kaliBlue flex items-center justify-center text-kaliBlue text-xs font-mono font-bold shrink-0">U</div>
                `;
            }
            chatContainer.appendChild(div);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function clearChat() {
            playClickSound();
            chatContainer.innerHTML = `
                <div class="flex items-start space-x-2.5">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-kaliCard border border-kaliCyan/60 flex items-center justify-center p-1 shrink-0">
                        <img src="https://www.kali.org/images/kali-dragon-icon.svg" alt="Logo" class="w-full h-full object-contain">
                    </div>
                    <div class="bg-kaliCard border border-kaliBorder p-3 rounded-xl text-gray-200 text-xs sm:text-sm max-w-2xl leading-relaxed font-mono">
                        Chat reset. How can I help you today?
                    </div>
                </div>
            `;
        }

        // IDE SNIPPETS (INCLUDING LUA)
        const snippets = {
            lua: `-- TokemekiAI Lua Engine Module\nlocal security = {}\n\nfunction security.init(author)\n    print("[+] KALI Lua Engine active - Developed by " .. author)\nend\n\nsecurity.init("TokemekiAI (CEO Etlijah Atienza / xlex175)")\n\nfor i = 1, 3 do\n    print("[*] Lua verification loop pass #" .. i)\nend`,
            
            python: `# Python Security Scanner\nimport socket\n\ndef check_port(host, port):\n    s = socket.socket()\n    s.settimeout(0.5)\n    return s.connect_ex((host, port)) == 0\n\nprint("[+] TokemekiAI Python Scanner Active")\nprint(f"[*] Port 80 Open: {check_port('127.0.0.1', 80)}")`,
            
            javascript: `// JS Node Security Guard\nconsole.log("[+] TokemekiAI Node Listener Loaded.");`,

            cpp: `// C++ Low-Level Inspector\n#include <iostream>\nint main() {\n    std::cout << "[+] TokemekiAI C++ Kernel Loaded\\n";\n    return 0;\n}`,

            rust: `fn main() {\n    println!("[+] TokemekiAI Rust Module Initialized.");\n}`,

            go: `package main\nimport "fmt"\nfunc main() {\n    fmt.Println("[+] Go Routine Active.")\n}`,

            bash: `#!/usr/bin/env bash\necho "[+] TokemekiAI Bash Guard Active"`,

            powershell: `Write-Host "[+] TokemekiAI PowerShell Guard Active" -ForegroundColor Cyan`,

            assembly: `; Assembly Syscall Snippet\nsection .text\n    global _start\n_start:\n    mov rax, 1\n    mov rdi, 1\n    syscall`
        };

        let activeLang = 'lua';

        function selectLanguage(lang) {
            playClickSound();
            activeLang = lang;
            document.querySelectorAll('.lang-btn').forEach(b => {
                b.classList.remove('bg-kaliCyan', 'text-black', 'font-bold');
                b.classList.add('bg-black/60', 'text-gray-300', 'border', 'border-gray-800');
            });

            const btn = document.getElementById('lang-' + lang);
            if (btn) {
                btn.classList.remove('bg-black/60', 'text-gray-300', 'border', 'border-gray-800');
                btn.classList.add('bg-kaliCyan', 'text-black', 'font-bold');
            }

            const extMap = { lua: 'lua', python: 'py', javascript: 'js', cpp: 'cpp', rust: 'rs', go: 'go', bash: 'sh', powershell: 'ps1', assembly: 'asm' };
            document.getElementById('code-filename').innerText = `module_${lang}.${extMap[lang] || 'txt'}`;
            document.getElementById('code-editor').value = snippets[lang] || '';
            document.getElementById('code-output').innerText = 'Click "Execute" to run snippet in sandbox...';
            document.getElementById('exec-status').innerText = 'Idle';
        }

        function copyCode() {
            const val = document.getElementById('code-editor').value;
            navigator.clipboard.writeText(val).then(() => {
                playClickSound();
                showToast('Code copied to clipboard.');
            }).catch(() => {
                const t = document.createElement("textarea");
                t.value = val;
                document.body.appendChild(t);
                t.select();
                document.execCommand('copy');
                document.body.removeChild(t);
                showToast('Code copied.');
            });
        }

        function runCodeSandbox() {
            playSendSound();
            document.getElementById('exec-status').innerText = 'Executing...';
            document.getElementById('code-output').innerText = 'Compiling & running in TokemekiAI sandbox...';
            
            setTimeout(() => {
                playRecvSound();
                document.getElementById('exec-status').innerText = 'Success (Exit 0)';
                document.getElementById('code-output').innerText = `[+] Sandbox execution completed.\nLanguage: ${activeLang.toUpperCase()}\nStatus: Process finished with 0 errors logged.`;
            }, 600);
        }

        function loadTemplate(type) {
            playClickSound();
            if (type === 'lua') {
                selectLanguage('lua');
                showToast('Loaded Lua script template.');
            } else if (type === 'socket') {
                selectLanguage('python');
                showToast('Loaded Socket template.');
            } else if (type === 'crypto') {
                selectLanguage('cpp');
                showToast('Loaded Crypto loop template.');
            }
        }

        // PENTEST GENERATOR
        function generateNmapCommand() {
            playClickSound();
            const target = document.getElementById('nmap-target').value || '127.0.0.1';
            const flags = document.getElementById('nmap-type').value;
            const res = document.getElementById('nmap-result');

            res.innerText = `[COMMAND]: nmap ${flags} ${target}\n\n[SIMULATION OUTPUT]:\nStarting Nmap scan on ${target}...\nPORT     STATE SERVICE\n22/tcp   open  ssh\n80/tcp   open  http\n443/tcp  open  https\nNmap done: 1 IP scanned.`;
        }

        // CIPHER UTILITY
        function transformCipher(type) {
            playClickSound();
            const input = document.getElementById('cipher-input').value;
            const output = document.getElementById('cipher-output');

            if (!input) {
                output.value = "Input text is empty.";
                return;
            }

            if (type === 'base64') {
                output.value = btoa(input);
            } else if (type === 'base64dec') {
                try { output.value = atob(input); } catch(e) { output.value = "Invalid Base64 format."; }
            } else if (type === 'rot13') {
                output.value = input.replace(/[a-zA-Z]/g, c => 
                    String.fromCharCode((c <= 'Z' ? 90 : 122) >= (c = c.charCodeAt(0) + 13) ? c : c - 26)
                );
            } else if (type === 'sha256') {
                output.value = "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08";
            }
        }

        // TERMINAL EMULATOR
        const terminalScreen = document.getElementById('terminal-screen');
        const terminalInput = document.getElementById('terminal-input');

        function appendTerminal(html) {
            const d = document.createElement('div');
            d.innerHTML = html;
            terminalScreen.appendChild(d);
            terminalScreen.scrollTop = terminalScreen.scrollHeight;
        }

        function handleTerminalSubmit(e) {
            e.preventDefault();
            const cmd = terminalInput.value.trim();
            if (!cmd) return;

            playSendSound();
            appendTerminal(`<span class="text-kaliCyan">kali@root:~$</span> <span class="text-white">${escapeHtml(cmd)}</span>`);
            terminalInput.value = '';

            const lower = cmd.toLowerCase();
            if (lower === 'help') {
                appendTerminal(`
                    <div class="text-gray-300 space-y-0.5 my-1">
                        <div><span class="text-kaliCyan font-bold">creator</span> - TokemekiAI & CEO details</div>
                        <div><span class="text-kaliCyan font-bold">lua</span> - Run sample Lua script output</div>
                        <div><span class="text-kaliCyan font-bold">whoami</span> - Display privileges</div>
                        <div><span class="text-kaliCyan font-bold">clear</span> - Clear terminal</div>
                    </div>
                `);
            } else if (lower === 'creator' || lower === 'company' || lower === 'ceo') {
                appendTerminal(`
                    <div class="text-kaliCyan my-1">
                        Company: TokemekiAI company<br>
                        CEO: Etlijah Atienza (xlex175)<br>
                        Platform: KALI AI OS v5.0
                    </div>
                `);
            } else if (lower === 'lua') {
                appendTerminal(`<div class="text-kaliNeonGreen">print("TokemekiAI Lua Runtime Active") -> Exit 0</div>`);
            } else if (lower === 'whoami') {
                appendTerminal(`<div class="text-kaliNeonGreen">root (UID 0) - FULL ACCESS</div>`);
            } else if (lower === 'clear') {
                clearTerminal();
            } else {
                playErrorSound();
                appendTerminal(`<div class="text-red-400">bash: ${escapeHtml(cmd)}: command not found.</div>`);
            }
        }

        function clearTerminal() {
            terminalScreen.innerHTML = `<div class="text-kaliCyan">Terminal cleared. Type <span class="text-white font-bold">help</span> for commands.</div>`;
        }

        function runQuickCommand(cmd) {
            switchTab('terminal');
            terminalInput.value = cmd;
            setTimeout(() => {
                document.getElementById('terminal-form').dispatchEvent(new Event('submit'));
            }, 100);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        setInterval(() => {
            const val = (10 + Math.random() * 8).toFixed(1);
            document.getElementById('cpu-metric').innerText = val + '%';
        }, 3000);
    </script>
</body>
