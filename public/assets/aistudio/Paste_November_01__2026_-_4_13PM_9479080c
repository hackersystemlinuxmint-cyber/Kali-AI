<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>KALI OS - Cyber AI & Development Suite</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        kaliBg: '#04070d',
                        kaliCard: '#090e17',
                        kaliPanel: '#0f172a',
                        kaliBorder: 'rgba(0, 210, 255, 0.25)',
                        kaliCyan: '#00d2ff',
                        kaliBlue: '#0597ff',
                        kaliNeonGreen: '#00ffaa',
                        kaliDarkGray: '#0b1320'
                    },
                    fontFamily: {
                        mono: ['JetBrains Mono', 'Fira Code', 'Courier New', 'monospace'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #04070d;
            color: #e2e8f0;
            overflow-x: hidden;
            touch-action: manipulation;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Glowing effects & Scanlines */
        .glow-cyan {
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.3);
        }
        .glow-blue {
            box-shadow: 0 0 25px rgba(5, 151, 255, 0.4);
        }
        .text-glow-cyan {
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.8);
        }
        .text-glow-blue {
            text-shadow: 0 0 12px rgba(5, 151, 255, 0.8);
        }
        .scanlines {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.35) 50%
            ), linear-gradient(
                90deg,
                rgba(0, 210, 255, 0.03),
                rgba(5, 151, 255, 0.02),
                rgba(0, 255, 170, 0.03)
            );
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #04070d;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 210, 255, 0.4);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00d2ff;
        }
        /* Pulse & Cyber Animations */
        @keyframes pulseGlow {
            0%, 100% { border-color: rgba(0, 210, 255, 0.4); box-shadow: 0 0 10px rgba(0, 210, 255, 0.2); }
            50% { border-color: rgba(5, 151, 255, 0.8); box-shadow: 0 0 22px rgba(5, 151, 255, 0.6); }
        }
        @keyframes cyberScan {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(1000%); }
        }
        @keyframes floatLogo {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-6px) scale(1.03); }
        }
        .animate-pulse-glow {
            animation: pulseGlow 3s infinite ease-in-out;
        }
        .animate-float {
            animation: floatLogo 4s infinite ease-in-out;
        }
        .cyber-scanner {
            animation: cyberScan 2.5s infinite linear;
        }
    </style>
</head>
<body class="bg-kaliBg text-gray-200 min-h-screen flex flex-col relative select-none">

